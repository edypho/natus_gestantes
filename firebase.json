{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "natus-gestantes",
          "appId": "1:1078564037217:android:a8730fbd791bfb686f4020",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "natus-gestantes",
          "configurations": {
            "android": "1:1078564037217:android:a8730fbd791bfb686f4020",
            "ios": "1:1078564037217:ios:15cbc04f0121b7736f4020",
            "macos": "1:1078564037217:ios:15cbc04f0121b7736f4020",
            "web": "1:1078564037217:web:d630421cef24e5746f4020",
            "windows": "1:1078564037217:web:31b4f0323bbeecb56f4020"
          }
        }
      }
    }
  },
  "hosting": {
    "predeploy": [
      "node functions/scripts/verify_hosting_release_readiness.js"
    ],
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.symbols",
      "**/*.map"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://*.googleusercontent.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://*.googleapis.com https://*.google.com https://*.gstatic.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://*.run.app https://viacep.com.br https://brasilapi.com.br; frame-src https://*.firebaseapp.com https://*.google.com https://*.googleapis.com; worker-src 'self' blob:; media-src 'self' blob: https://firebasestorage.googleapis.com https://storage.googleapis.com; manifest-src 'self'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "0"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/canvaskit/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/*.wasm",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600,must-revalidate"
          }
        ]
      },
      {
        "source": "/downloads/*.apk",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"natus-android-1.1.2.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "predeploy": [
      "node functions/scripts/verify_hosting_release_readiness.js"
    ],
    "rules": "firebase/security/firestore.rules",
    "indexes": "firebase/security/firestore.indexes.json"
  },
  "storage": {
    "predeploy": [
      "node functions/scripts/verify_hosting_release_readiness.js"
    ],
    "rules": "firebase/security/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firestore-debug.log",
        "firestore-debug.*.log",
        "**/*.log",
        "*.local",
        "audit-reports/**",
        "migration/**",
        "scripts/**",
        "test/**"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" test"
      ]
    }
  ]
}
