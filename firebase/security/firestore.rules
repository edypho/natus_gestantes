rules_version = '2';

// Regras ativas via firebase.json. Toda alteração deve passar pela auditoria
// multi-tenant e pelos testes no Emulator antes da publicação.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn() && userData().get('status', '') == 'ativo';
    }

    function hasClinicaId(data) {
      return data.get('clinicaId', '') is string &&
        data.get('clinicaId', '').size() > 0;
    }

    function hasAdminDonoId(data) {
      return data.get('adminDonoId', '') is string &&
        data.get('adminDonoId', '').size() > 0;
    }

    // Durante o backfill, a leitura aceita um dos aliases. Se ambos existirem,
    // eles obrigatoriamente precisam apontar para a mesma clínica.
    function tenantAliasesCompatible(data) {
      return (!hasClinicaId(data) || !hasAdminDonoId(data)) ||
        data.clinicaId == data.adminDonoId;
    }

    function tenantIdFrom(data) {
      return hasClinicaId(data)
        ? data.clinicaId
        : (hasAdminDonoId(data) ? data.adminDonoId : '');
    }

    function belongsToTenantDualRead(data, tenantId) {
      return tenantAliasesCompatible(data) &&
        ((hasClinicaId(data) && data.clinicaId == tenantId) ||
          (hasAdminDonoId(data) && data.adminDonoId == tenantId));
    }

    // Todo create/update depois da ativação precisa convergir os aliases.
    function canonicalTenantWrite(data, tenantId) {
      return hasClinicaId(data) &&
        hasAdminDonoId(data) &&
        data.clinicaId == tenantId &&
        data.adminDonoId == tenantId;
    }

    function normalizeRole(value) {
      return value == 'superAdmin' ||
          value == 'superadmin' ||
          value == 'super_admin'
        ? 'superAdmin'
        : (value == 'admin'
          ? 'admin'
          : (value == 'profissional'
            ? 'profissional'
            : (value == 'enfermeira'
              ? 'enfermeira'
              : (value == 'obstetra'
                ? 'obstetra'
                : (value == 'paciente' || value == 'gestante'
                  ? 'paciente'
                  : '')))));
    }

    function hasTipo(data) {
      return data.get('tipo', '') is string && data.get('tipo', '').size() > 0;
    }

    function hasTipoUsuario(data) {
      return data.get('tipoUsuario', '') is string &&
        data.get('tipoUsuario', '').size() > 0;
    }

    function roleAliasesCompatible(data) {
      return (!hasTipo(data) || !hasTipoUsuario(data)) ||
        normalizeRole(data.tipo) == normalizeRole(data.tipoUsuario);
    }

    function roleFrom(data) {
      return hasTipo(data)
        ? normalizeRole(data.tipo)
        : (hasTipoUsuario(data) ? normalizeRole(data.tipoUsuario) : '');
    }

    function knownClinicRole(role) {
      return role in [
        'admin',
        'profissional',
        'enfermeira',
        'obstetra',
        'paciente'
      ];
    }

    function superAdminClaim() {
      return signedIn() && request.auth.token.get('superAdmin', false) == true;
    }

    // O campo de perfil sozinho nunca concede poder global. São exigidos
    // custom claim, perfil normalizado conhecido e usuário ativo.
    function isSuperAdmin() {
      return superAdminClaim() &&
        userData().get('status', '') == 'ativo' &&
        roleAliasesCompatible(userData()) &&
        roleFrom(userData()) == 'superAdmin';
    }

    function canonicalTenantActive(tenantId) {
      let data = get(
        /databases/$(database)/documents/clinicas/$(tenantId)
      ).data;
      return belongsToTenantDualRead(data, tenantId) &&
        data.get('status', '') in ['ativa', 'teste'];
    }

    function legacyTenantActive(tenantId) {
      let data = get(
        /databases/$(database)/documents/clinicasSaaS/$(tenantId)
      ).data;
      return belongsToTenantDualRead(data, tenantId) &&
        data.get('status', '') in ['ativa', 'teste'];
    }

    function tenantActive(tenantId) {
      return tenantId is string &&
        tenantId.size() > 0 &&
        (exists(/databases/$(database)/documents/clinicas/$(tenantId))
          ? canonicalTenantActive(tenantId)
          : (exists(
              /databases/$(database)/documents/clinicasSaaS/$(tenantId)
            ) && legacyTenantActive(tenantId)));
    }

    function hasTenantRole(data, tenantId, allowedRoles) {
      let role = roleFrom(data);
      return data.get('status', '') == 'ativo' &&
        roleAliasesCompatible(data) &&
        role in allowedRoles &&
        belongsToTenantDualRead(data, tenantId) &&
        tenantActive(tenantId);
    }

    function hasPatientRole(data) {
      let tipo = data.get('tipo', '');
      let tipoUsuario = data.get('tipoUsuario', '');
      return tipo is string &&
        tipoUsuario is string &&
        (tipo in ['', 'paciente', 'gestante']) &&
        (tipoUsuario in ['', 'paciente', 'gestante']) &&
        (tipo in ['paciente', 'gestante'] ||
          tipoUsuario in ['paciente', 'gestante']);
    }

    function isPatientTenantUser(data, tenantId) {
      return data.get('status', '') == 'ativo' &&
        hasPatientRole(data) &&
        belongsToTenantDualRead(data, tenantId) &&
        tenantActive(tenantId);
    }

    // Compatibilidade de leitura para o portal após a migração multi-tenant.
    //
    // A validação completa de vínculos continua nas escritas e na auditoria da
    // migração. Em consultas legadas ela ultrapassa o limite de expressões do
    // Firestore Rules antes de avaliar os documentos. Este gate recebe o campo
    // exato usado pela consulta do portal e exige: usuário paciente ativo,
    // clínica ativa, os dois aliases do tenant iguais e nenhum alias UID
    // conflitante. Assim a consulta permanece isolada por clínica e paciente
    // sem transformar as regras em filtro.
    function migratedPatientCanReadLegacy(data, queriedPatientUid) {
      let currentUser = userData();
      let tenantId = currentUser.get('clinicaId', '');
      return signedIn() &&
        currentUser.get('status', '') == 'ativo' &&
        currentUser.get('tipo', '') in ['paciente', 'gestante'] &&
        currentUser.get('tipoUsuario', '') in ['paciente', 'gestante'] &&
        tenantId is string &&
        tenantId.size() > 0 &&
        currentUser.get('adminDonoId', '') == tenantId &&
        data.get('adminDonoId', '') == tenantId &&
        data.get('clinicaId', '') == tenantId &&
        queriedPatientUid == request.auth.uid &&
        (data.get('uidPaciente', '') == '' ||
          data.get('uidPaciente', '') == request.auth.uid) &&
        (data.get('pacienteUid', '') == '' ||
          data.get('pacienteUid', '') == request.auth.uid) &&
        (data.get('uidGestante', '') == '' ||
          data.get('uidGestante', '') == request.auth.uid) &&
        (data.get('gestanteUid', '') == '' ||
          data.get('gestanteUid', '') == request.auth.uid) &&
        tenantActive(tenantId);
    }

    function isTenantMember(tenantId) {
      return signedIn() && hasTenantRole(userData(), tenantId, [
        'admin',
        'profissional',
        'enfermeira',
        'obstetra',
        'paciente'
      ]);
    }

    function isTenantAdmin(tenantId) {
      return signedIn() &&
        hasTenantRole(userData(), tenantId, ['admin']);
    }

    function isTenantStaff(tenantId) {
      return signedIn() && hasTenantRole(userData(), tenantId, [
        'admin',
        'profissional',
        'enfermeira',
        'obstetra'
      ]);
    }

    function optionalPatientAliasIsString(data, field) {
      return data.get(field, '') is string;
    }

    function patientAliasPairCompatible(data, first, second) {
      return optionalPatientAliasIsString(data, first) &&
        optionalPatientAliasIsString(data, second) &&
        (data.get(first, '') == '' ||
          data.get(second, '') == '' ||
          data.get(first, '') == data.get(second, ''));
    }

    function patientIdAliasesCompatible(data) {
      return patientAliasPairCompatible(data, 'pacienteId', 'gestanteId') &&
        patientAliasPairCompatible(data, 'pacienteId', 'idGestante') &&
        patientAliasPairCompatible(data, 'gestanteId', 'idGestante');
    }

    function patientUidAliasesCompatible(data) {
      return patientAliasPairCompatible(data, 'uidPaciente', 'pacienteUid') &&
        patientAliasPairCompatible(data, 'uidPaciente', 'uidGestante') &&
        patientAliasPairCompatible(data, 'uidPaciente', 'gestanteUid') &&
        patientAliasPairCompatible(data, 'pacienteUid', 'uidGestante') &&
        patientAliasPairCompatible(data, 'pacienteUid', 'gestanteUid') &&
        patientAliasPairCompatible(data, 'uidGestante', 'gestanteUid');
    }

    function patientIdMatchesUser(data, patientId) {
      let pacienteId = data.get('pacienteId', '');
      let gestanteId = data.get('gestanteId', '');
      let idGestante = data.get('idGestante', '');
      let uidPaciente = data.get('uidPaciente', '');
      let pacienteUid = data.get('pacienteUid', '');
      let uidGestante = data.get('uidGestante', '');
      let gestanteUid = data.get('gestanteUid', '');
      return patientId is string &&
        patientId.size() > 0 &&
        pacienteId is string &&
        gestanteId is string &&
        idGestante is string &&
        (pacienteId == patientId ||
          gestanteId == patientId ||
          idGestante == patientId) &&
        (pacienteId == '' || pacienteId == patientId) &&
        (gestanteId == '' || gestanteId == patientId) &&
        (idGestante == '' || idGestante == patientId) &&
        uidPaciente is string &&
        pacienteUid is string &&
        uidGestante is string &&
        gestanteUid is string &&
        (uidPaciente == request.auth.uid ||
          pacienteUid == request.auth.uid ||
          uidGestante == request.auth.uid ||
          gestanteUid == request.auth.uid) &&
        (uidPaciente == '' || uidPaciente == request.auth.uid) &&
        (pacienteUid == '' || pacienteUid == request.auth.uid) &&
        (uidGestante == '' || uidGestante == request.auth.uid) &&
        (gestanteUid == '' || gestanteUid == request.auth.uid);
    }

    function patientUidMatches(data) {
      return signedIn() &&
        patientUidAliasesCompatible(data) &&
        (data.get('uidPaciente', '') == request.auth.uid ||
          data.get('pacienteUid', '') == request.auth.uid ||
          data.get('uidGestante', '') == request.auth.uid ||
          data.get('gestanteUid', '') == request.auth.uid);
    }

    function patientPathOwnedByCurrentUser(tenantId, patientId) {
      let data = userData();
      return signedIn() &&
        isPatientTenantUser(data, tenantId) &&
        (patientIdMatchesUser(data, patientId) ||
          (exists(
            /databases/$(database)/documents/clinicas/$(tenantId)/pacientes/$(patientId)
          ) && patientUidMatches(get(
            /databases/$(database)/documents/clinicas/$(tenantId)/pacientes/$(patientId)
          ).data)));
    }

    function patientIdFrom(data) {
      return data.get('pacienteId', '') != ''
        ? data.get('pacienteId', '')
        : (data.get('gestanteId', '') != ''
          ? data.get('gestanteId', '')
          : data.get('idGestante', ''));
    }

    function canonicalPatientWrite(data, patientId) {
      return data.get('pacienteId', '') is string &&
        data.get('pacienteId', '') == patientId &&
        patientIdAliasesCompatible(data) &&
        patientUidAliasesCompatible(data);
    }

    function legacyRecordOwnedByCurrentPatient(data) {
      let tenantId = tenantIdFrom(data);
      let patientId = patientIdFrom(data);
      let currentUser = userData();
      return belongsToTenantDualRead(data, tenantId) &&
        patientIdAliasesCompatible(data) &&
        patientUidAliasesCompatible(data) &&
        signedIn() &&
        isPatientTenantUser(currentUser, tenantId) &&
        (patientUidMatches(data) ||
          (patientId is string &&
            patientId.size() > 0 &&
            patientIdMatchesUser(currentUser, patientId)));
    }

    // O paciente pode criar apenas um registro explicitamente associado ao
    // próprio cadastro e UID. Update/delete continuam reservados à equipe.
    function patientCanCreateOwnRecord(data, tenantId, patientId) {
      let currentUser = userData();
      return patientId is string &&
        patientId.size() > 0 &&
        canonicalTenantWrite(data, tenantId) &&
        signedIn() &&
        isPatientTenantUser(currentUser, tenantId) &&
        patientIdMatchesUser(currentUser, patientId) &&
        patientUidMatches(data) &&
        data.get('criadoPorUid', '') == request.auth.uid;
    }

    function patientCanCreateOwnLegacyRecord(data) {
      let tenantId = tenantIdFrom(data);
      let patientId = patientIdFrom(data);
      return patientCanCreateOwnRecord(data, tenantId, patientId);
    }

    function canCreateForTenant(tenantId) {
      return canonicalTenantWrite(request.resource.data, tenantId);
    }

    function canUpdateForTenant(tenantId) {
      return belongsToTenantDualRead(resource.data, tenantId) &&
        canonicalTenantWrite(request.resource.data, tenantId);
    }

    function canDeleteForTenant(tenantId) {
      return belongsToTenantDualRead(resource.data, tenantId);
    }

    function validShortString(data, field, maxSize) {
      return data.get(field, '') is string &&
        data.get(field, '').size() <= maxSize;
    }

    function validOwnProfileValues() {
      let data = request.resource.data;
      let photoUrl = data.get('fotoUrl', '');
      let pushTokens = data.get('pushTokens', []);
      return validShortString(data, 'nome', 200) &&
        validShortString(data, 'fotoUrl', 2048) &&
        (photoUrl == '' || photoUrl.matches(
          '^https://firebasestorage\\.googleapis\\.com/v0/b/' +
          'natus-gestantes\\.firebasestorage\\.app/o/.*'
        )) &&
        validShortString(data, 'fotoAtualizadaEm', 64) &&
        validShortString(data, 'tema', 50) &&
        data.get('pushAtivo', false) is bool &&
        pushTokens is list &&
        pushTokens.size() <= 5 &&
        validShortString(data, 'pushUltimoToken', 4096) &&
        validShortString(data, 'pushPlataforma', 20) &&
        validShortString(data, 'pushAtualizadoEm', 64) &&
        validShortString(data, 'pushPermissao', 32) &&
        validShortString(data, 'pushPermissaoAtualizadaEm', 64) &&
        data.get('pushSuportadoNaPlataforma', false) is bool;
    }

    function safeOwnProfileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome',
        'fotoUrl',
        'fotoAtualizadaEm',
        'tema',
        'pushAtivo',
        'pushTokens',
        'pushUltimoToken',
        'pushPlataforma',
        'pushAtualizadoEm',
        'pushPermissao',
        'pushPermissaoAtualizadaEm',
        'pushSuportadoNaPlataforma'
      ]) && validOwnProfileValues();
    }

    // Após o updatePassword, o próprio usuário pode confirmar exatamente uma
    // transição primeiroLogin: true -> false. O serverTimestamp precisa ser o
    // timestamp da requisição; a regra não permite reabrir o primeiro acesso.
    function validOwnFirstLoginTransition() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'nome',
          'fotoUrl',
          'fotoAtualizadaEm',
          'tema',
          'pushAtivo',
          'pushTokens',
          'pushUltimoToken',
          'pushPlataforma',
          'pushAtualizadoEm',
          'pushPermissao',
          'pushPermissaoAtualizadaEm',
          'pushSuportadoNaPlataforma',
          'primeiroLogin',
          'senhaAlteradaEm'
        ]) &&
        changed.hasAll(['primeiroLogin', 'senhaAlteradaEm']) &&
        resource.data.get('primeiroLogin', false) == true &&
        request.resource.data.get('primeiroLogin', true) == false &&
        request.resource.data.get('senhaAlteradaEm', null) is timestamp &&
        request.resource.data.get('senhaAlteradaEm', null) == request.time &&
        validOwnProfileValues();
    }

    function safeOwnUserFieldsOnly() {
      return safeOwnProfileFieldsOnly() || validOwnFirstLoginTransition();
    }

    function validClinicUserPayload(data) {
      return roleAliasesCompatible(data) &&
        knownClinicRole(roleFrom(data)) &&
        data.get('status', '') in ['ativo', 'inativo', 'bloqueado'];
    }

    function validDirectoryUserPayload(data) {
      return roleAliasesCompatible(data) &&
        data.get('status', '') in ['ativo', 'inativo', 'bloqueado'] &&
        ((roleFrom(data) == 'superAdmin' &&
            !hasClinicaId(data) &&
            !hasAdminDonoId(data)) ||
          (knownClinicRole(roleFrom(data)) &&
            canonicalTenantWrite(data, tenantIdFrom(data))));
    }

    function legacyStaffRead(data) {
      let tenantId = tenantIdFrom(data);
      return isSuperAdmin() ||
        (belongsToTenantDualRead(data, tenantId) &&
          isTenantStaff(tenantId));
    }

    function legacyStaffCreate(data, adminOnly) {
      let tenantId = tenantIdFrom(data);
      return canonicalTenantWrite(data, tenantId) &&
        (isSuperAdmin() ||
          (adminOnly ? isTenantAdmin(tenantId) : isTenantStaff(tenantId)));
    }

    function legacyStaffUpdate(oldData, newData, adminOnly) {
      let tenantId = tenantIdFrom(oldData);
      return belongsToTenantDualRead(oldData, tenantId) &&
        canonicalTenantWrite(newData, tenantId) &&
        (isSuperAdmin() ||
          (adminOnly ? isTenantAdmin(tenantId) : isTenantStaff(tenantId)));
    }

    function legacyStaffDelete(data) {
      let tenantId = tenantIdFrom(data);
      return belongsToTenantDualRead(data, tenantId) &&
        (isSuperAdmin() || isTenantAdmin(tenantId));
    }

    function legacyClinicalRead(data, queriedPatientUid) {
      let tenantId = tenantIdFrom(data);
      return isSuperAdmin() ||
        (belongsToTenantDualRead(data, tenantId) &&
          (isTenantStaff(tenantId) ||
            migratedPatientCanReadLegacy(data, queriedPatientUid)));
    }

    function legacyClinicalCreate(data, collectionName) {
      let tenantId = tenantIdFrom(data);
      return canonicalTenantWrite(data, tenantId) &&
        (isSuperAdmin() || isTenantStaff(tenantId) ||
          (collectionName in ['exames', 'documentos'] &&
            patientCanCreateOwnLegacyRecord(data)));
    }

    function legacyClinicalUpdate(oldData, newData) {
      let tenantId = tenantIdFrom(oldData);
      return belongsToTenantDualRead(oldData, tenantId) &&
        canonicalTenantWrite(newData, tenantId) &&
        (isSuperAdmin() || isTenantStaff(tenantId));
    }

    function legacyClinicalDelete(data) {
      let tenantId = tenantIdFrom(data);
      return belongsToTenantDualRead(data, tenantId) &&
        (isSuperAdmin() || isTenantAdmin(tenantId));
    }

    function legacyFinancialRead(data, queriedPatientUid) {
      let tenantId = tenantIdFrom(data);
      return isSuperAdmin() ||
        (belongsToTenantDualRead(data, tenantId) &&
          (isTenantAdmin(tenantId) ||
            migratedPatientCanReadLegacy(data, queriedPatientUid)));
    }

    function legacyFinancialWrite(oldData, newData, isCreate) {
      let tenantId = tenantIdFrom(isCreate ? newData : oldData);
      return (isCreate || belongsToTenantDualRead(oldData, tenantId)) &&
        canonicalTenantWrite(newData, tenantId) &&
        (isSuperAdmin() || isTenantAdmin(tenantId));
    }

    function legacyCatalogRead(data) {
      let tenantId = tenantIdFrom(data);
      return isSuperAdmin() ||
        (belongsToTenantDualRead(data, tenantId) &&
          isTenantMember(tenantId));
    }

    function legacyCatalogWrite(oldData, newData, isCreate) {
      let tenantId = tenantIdFrom(isCreate ? newData : oldData);
      return (isCreate || belongsToTenantDualRead(oldData, tenantId)) &&
        canonicalTenantWrite(newData, tenantId) &&
        (isSuperAdmin() || isTenantAdmin(tenantId));
    }

    function monotonicReadReceipt() {
      let previousReaders = resource.data.get('lidasPor', []);
      let nextReaders = request.resource.data.get('lidasPor', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lidasPor',
        'atualizadoEm'
      ]) &&
        nextReaders is list &&
        previousReaders is list &&
        nextReaders.toSet() == previousReaders.toSet().union(
          [request.auth.uid].toSet()
        ) &&
        nextReaders.size() == nextReaders.toSet().size();
    }

    // ------------------------------------------------------------------
    // Diretório global mínimo para bootstrap de autenticação.
    // ------------------------------------------------------------------
    match /usuarios/{userId} {
      allow get: if isSuperAdmin() ||
        (signedIn() &&
          request.auth.uid == userId &&
          resource.data.get('status', '') == 'ativo');

      allow list: if isSuperAdmin() ||
        (tenantAliasesCompatible(resource.data) &&
          isTenantAdmin(tenantIdFrom(resource.data)));

      allow create: if (isSuperAdmin() &&
          validDirectoryUserPayload(request.resource.data) &&
          request.resource.data.get('uid', '') == userId) ||
        (canonicalTenantWrite(
            request.resource.data,
            tenantIdFrom(request.resource.data)
          ) &&
          isTenantAdmin(tenantIdFrom(request.resource.data)) &&
          validClinicUserPayload(request.resource.data) &&
          request.resource.data.get('uid', '') == userId);

      allow update: if (isSuperAdmin() &&
          validDirectoryUserPayload(request.resource.data) &&
          request.resource.data.get('uid', '') == userId) ||
        (signedIn() &&
          request.auth.uid == userId &&
          resource.data.get('status', '') == 'ativo' &&
          safeOwnUserFieldsOnly() &&
          belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          canonicalTenantWrite(
            request.resource.data,
            tenantIdFrom(resource.data)
          ) &&
          request.resource.data.get('uid', '') == userId) ||
        (signedIn() &&
          request.auth.uid != userId &&
          belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          isTenantAdmin(tenantIdFrom(resource.data)) &&
          canonicalTenantWrite(
            request.resource.data,
            tenantIdFrom(resource.data)
          ) &&
          validClinicUserPayload(request.resource.data) &&
          request.resource.data.get('uid', '') == userId);

      allow delete: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          isTenantAdmin(tenantIdFrom(resource.data)) &&
          request.auth.uid != userId);
    }

    // ------------------------------------------------------------------
    // Nova hierarquia canônica: clinicas/{tenantId}/...
    // ------------------------------------------------------------------
    match /clinicas/{tenantId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantId) &&
          isTenantMember(tenantId));
      allow create, update: if isSuperAdmin() &&
        canonicalTenantWrite(request.resource.data, tenantId) &&
        request.resource.data.get('status', '') in [
          'ativa',
          'teste',
          'pausada',
          'bloqueada',
          'excluida'
        ];
      allow delete: if isSuperAdmin();

      match /usuarios/{userId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            (isTenantAdmin(tenantId) ||
              (isTenantMember(tenantId) && request.auth.uid == userId)));
        allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canCreateForTenant(tenantId) &&
          validClinicUserPayload(request.resource.data) &&
          request.resource.data.get('uid', '') == userId;
        allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canUpdateForTenant(tenantId) &&
          validClinicUserPayload(request.resource.data) &&
          request.resource.data.get('uid', '') == userId;
        allow update: if signedIn() &&
          request.auth.uid == userId &&
          resource.data.get('status', '') == 'ativo' &&
          belongsToTenantDualRead(resource.data, tenantId) &&
          canUpdateForTenant(tenantId) &&
          safeOwnProfileFieldsOnly() &&
          request.resource.data.get('uid', '') == userId;
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          request.auth.uid != userId &&
          canDeleteForTenant(tenantId);
      }

      match /profissionais/{professionalId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            isTenantStaff(tenantId));
        allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      // Planos e biblioteca são configurações próprias de cada clínica, não
      // catálogos globais compartilhados entre tenants.
      match /planos/{planId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            isTenantMember(tenantId));
        allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      match /biblioteca/{materialId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            isTenantMember(tenantId));
        allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      match /pacientes/{patientId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            (patientPathOwnedByCurrentUser(tenantId, patientId) ||
              isTenantStaff(tenantId)));
        allow create: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canCreateForTenant(tenantId) &&
          canonicalPatientWrite(request.resource.data, patientId);
        allow update: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canUpdateForTenant(tenantId) &&
          canonicalPatientWrite(request.resource.data, patientId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);

        // Prontuário interno é deliberadamente mais restrito.
        match /prontuario/{recordPath=**} {
          allow read: if isSuperAdmin() ||
            (belongsToTenantDualRead(resource.data, tenantId) &&
              isTenantStaff(tenantId));
          allow create: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
            canCreateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow update: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
            canUpdateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canDeleteForTenant(tenantId);
        }

        match /atendimentos/{recordPath=**} {
          allow read: if isSuperAdmin() ||
            (belongsToTenantDualRead(resource.data, tenantId) &&
              isTenantStaff(tenantId));
        }

        // Contratos são visíveis à equipe e à própria paciente, mas qualquer
        // mutação direta exige administração do tenant.
        match /contratos/{recordPath=**} {
          allow read: if isSuperAdmin() ||
            (belongsToTenantDualRead(resource.data, tenantId) &&
              (patientPathOwnedByCurrentUser(tenantId, patientId) ||
                isTenantStaff(tenantId)));
          allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canCreateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canUpdateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canDeleteForTenant(tenantId);
        }

        // O paciente pode ler os próprios recursos e criar apenas exames ou
        // documentos próprios. Não pode alterar nem excluir após o envio.
        match /{patientCollection}/{recordPath=**} {
          allow read: if patientCollection in [
              'exames',
              'documentos',
              'agenda'
            ] &&
            (isSuperAdmin() ||
              (belongsToTenantDualRead(resource.data, tenantId) &&
                (patientPathOwnedByCurrentUser(tenantId, patientId) ||
                  isTenantStaff(tenantId))));
          allow create: if patientCollection in [
              'exames',
              'documentos',
              'agenda',
              'atendimentos'
            ] &&
            canCreateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId) &&
            ((isSuperAdmin() || isTenantStaff(tenantId)) ||
              (patientCollection in ['exames', 'documentos'] &&
                patientCanCreateOwnRecord(
                  request.resource.data,
                  tenantId,
                  patientId
                )));
          allow update: if patientCollection in [
              'exames',
              'documentos',
              'agenda',
              'atendimentos'
            ] &&
            (isSuperAdmin() || isTenantStaff(tenantId)) &&
            canUpdateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow delete: if patientCollection in [
              'exames',
              'documentos',
              'agenda',
              'atendimentos'
            ] &&
            (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canDeleteForTenant(tenantId);
        }

        match /financeiro/{recordPath=**} {
          allow read: if isSuperAdmin() ||
            (belongsToTenantDualRead(resource.data, tenantId) &&
              (patientPathOwnedByCurrentUser(tenantId, patientId) ||
                isTenantAdmin(tenantId)));
          allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canCreateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canUpdateForTenant(tenantId) &&
            canonicalPatientWrite(request.resource.data, patientId);
          allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
            canDeleteForTenant(tenantId);
        }
      }

      match /agenda/{eventId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            (isTenantStaff(tenantId) ||
              legacyRecordOwnedByCurrentPatient(resource.data)));
        allow create: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      // Operação clínica geral, sem prontuário ou financeiro.
      match /operacao/{operationPath=**} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            isTenantStaff(tenantId));
        allow create: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantStaff(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      // Journals internos das Functions, exclusivos do Admin SDK.
      match /operacoesSistema/{systemOperationPath=**} {
        allow read, write: if false;
      }

      // Financeiro da clínica nunca é exposto a profissionais não-admin.
      match /financeiro/{financialPath=**} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            (isTenantAdmin(tenantId) ||
              legacyRecordOwnedByCurrentPatient(resource.data)));
        allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      match /configuracoes/{configPath=**} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            isTenantMember(tenantId));
        allow create: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canCreateForTenant(tenantId);
        allow update: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canUpdateForTenant(tenantId);
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      match /notificacoes/{notificationId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            (isTenantStaff(tenantId) ||
              (isTenantMember(tenantId) &&
                resource.data.get('destinatariosUids', []) is list &&
                request.auth.uid in resource.data.destinatariosUids)));
        allow create: if false;
        allow update: if (isTenantStaff(tenantId) ||
            (isTenantMember(tenantId) &&
              resource.data.get('destinatariosUids', []) is list &&
              request.auth.uid in resource.data.destinatariosUids)) &&
          canUpdateForTenant(tenantId) &&
          monotonicReadReceipt();
        allow delete: if (isSuperAdmin() || isTenantAdmin(tenantId)) &&
          canDeleteForTenant(tenantId);
      }

      match /logs/{logId} {
        allow read: if isSuperAdmin() ||
          (belongsToTenantDualRead(resource.data, tenantId) &&
            isTenantAdmin(tenantId));
        allow create: if isTenantStaff(tenantId) &&
          canCreateForTenant(tenantId) &&
          request.resource.data.get('usuarioUid', '') == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Caminhos legados temporários. Leituras aceitam os aliases; qualquer
    // create/update já precisa gravar os dois campos iguais.
    // ------------------------------------------------------------------
    match /gestantes/{patientId} {
      allow get: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          (isTenantStaff(tenantIdFrom(resource.data)) ||
            patientPathOwnedByCurrentUser(
              tenantIdFrom(resource.data),
              patientId
            ) ||
            migratedPatientCanReadLegacy(
              resource.data,
              resource.data.get('uidGestante', '')
            )));
      allow list: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          (isTenantStaff(tenantIdFrom(resource.data)) ||
            migratedPatientCanReadLegacy(
              resource.data,
              resource.data.get('uidGestante', '')
            )));
      allow create: if canonicalTenantWrite(
          request.resource.data,
          tenantIdFrom(request.resource.data)
        ) &&
        (isSuperAdmin() || isTenantStaff(tenantIdFrom(request.resource.data)));
      allow update: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        canonicalTenantWrite(request.resource.data, tenantIdFrom(resource.data)) &&
        (isSuperAdmin() || isTenantStaff(tenantIdFrom(resource.data)));
      allow delete: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        (isSuperAdmin() || isTenantAdmin(tenantIdFrom(resource.data)));
    }

    // Contrato legado top-level: leitura clínica/paciente e escrita somente
    // administrativa. O SuperAdmin depende do gate isSuperAdmin().
    match /contratos/{contractId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          (isTenantStaff(tenantIdFrom(resource.data)) ||
            legacyRecordOwnedByCurrentPatient(resource.data)));
      allow create: if canonicalTenantWrite(
          request.resource.data,
          tenantIdFrom(request.resource.data)
        ) &&
        (isSuperAdmin() || isTenantAdmin(tenantIdFrom(request.resource.data)));
      allow update: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        canonicalTenantWrite(request.resource.data, tenantIdFrom(resource.data)) &&
        (isSuperAdmin() || isTenantAdmin(tenantIdFrom(resource.data)));
      allow delete: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        (isSuperAdmin() || isTenantAdmin(tenantIdFrom(resource.data)));
    }

    match /contracoes/{contractionId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          (isTenantStaff(tenantIdFrom(resource.data)) ||
            migratedPatientCanReadLegacy(
              resource.data,
              resource.data.get('uidGestante', '')
            )));
      allow create: if canonicalTenantWrite(
          request.resource.data,
          tenantIdFrom(request.resource.data)
        ) &&
        (isSuperAdmin() ||
          isTenantStaff(tenantIdFrom(request.resource.data)) ||
          legacyRecordOwnedByCurrentPatient(request.resource.data));
      allow update: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        canonicalTenantWrite(request.resource.data, tenantIdFrom(resource.data)) &&
        (isSuperAdmin() ||
          isTenantStaff(tenantIdFrom(resource.data)) ||
          legacyRecordOwnedByCurrentPatient(resource.data));
      allow delete: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        (isSuperAdmin() || isTenantStaff(tenantIdFrom(resource.data)));
    }

    match /materiais/{materialId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          isTenantStaff(tenantIdFrom(resource.data)));
      allow create: if canonicalTenantWrite(
          request.resource.data,
          tenantIdFrom(request.resource.data)
        ) &&
        (isSuperAdmin() || isTenantStaff(tenantIdFrom(request.resource.data)));
      allow update: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        canonicalTenantWrite(request.resource.data, tenantIdFrom(resource.data)) &&
        (isSuperAdmin() || isTenantStaff(tenantIdFrom(resource.data)));
      allow delete: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        (isSuperAdmin() || isTenantAdmin(tenantIdFrom(resource.data)));
    }

    match /notificacoesCentral/{notificationId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          isTenantStaff(tenantIdFrom(resource.data)));
      allow create: if false;
      allow update: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        canonicalTenantWrite(request.resource.data, tenantIdFrom(resource.data)) &&
        isTenantStaff(tenantIdFrom(resource.data)) &&
        monotonicReadReceipt();
      allow delete: if belongsToTenantDualRead(
          resource.data,
          tenantIdFrom(resource.data)
        ) &&
        (isSuperAdmin() || isTenantAdmin(tenantIdFrom(resource.data)));
    }

    // Matchers explícitos impedem que um caminho como usuarios/{uid} avalie
    // blocos legados não relacionados e estoure o orçamento de expressões.
    match /enfermeiras/{documentId} {
      allow read: if legacyStaffRead(resource.data);
      allow create: if legacyStaffCreate(request.resource.data, true);
      allow update: if legacyStaffUpdate(
        resource.data,
        request.resource.data,
        true
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /obstetras/{documentId} {
      allow read: if legacyStaffRead(resource.data);
      allow create: if legacyStaffCreate(request.resource.data, true);
      allow update: if legacyStaffUpdate(
        resource.data,
        request.resource.data,
        true
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /atendimentos/{documentId} {
      allow read: if legacyClinicalRead(
        resource.data,
        resource.data.get('uidGestante', '')
      );
      allow create: if legacyClinicalCreate(
        request.resource.data,
        'atendimentos'
      );
      allow update: if legacyClinicalUpdate(
        resource.data,
        request.resource.data
      );
      allow delete: if legacyClinicalDelete(resource.data);
    }

    match /exames/{documentId} {
      allow read: if legacyClinicalRead(
        resource.data,
        resource.data.get('uidGestante', '')
      );
      allow create: if legacyClinicalCreate(
        request.resource.data,
        'exames'
      );
      allow update: if legacyClinicalUpdate(
        resource.data,
        request.resource.data
      );
      allow delete: if legacyClinicalDelete(resource.data);
    }

    match /documentos/{documentId} {
      allow read: if legacyClinicalRead(
        resource.data,
        resource.data.get('uidGestante', '')
      );
      allow create: if legacyClinicalCreate(
        request.resource.data,
        'documentos'
      );
      allow update: if legacyClinicalUpdate(
        resource.data,
        request.resource.data
      );
      allow delete: if legacyClinicalDelete(resource.data);
    }

    match /agenda/{documentId} {
      allow read: if legacyClinicalRead(
        resource.data,
        resource.data.get('gestanteUid', '')
      );
      allow create: if legacyClinicalCreate(
        request.resource.data,
        'agenda'
      );
      allow update: if legacyClinicalUpdate(
        resource.data,
        request.resource.data
      );
      allow delete: if legacyClinicalDelete(resource.data);
    }

    match /prontuario_atendimentos/{documentId} {
      allow read: if legacyStaffRead(resource.data);
      allow create: if legacyStaffCreate(request.resource.data, false);
      allow update: if legacyStaffUpdate(
        resource.data,
        request.resource.data,
        false
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /prontuarios/{documentId} {
      allow read: if legacyStaffRead(resource.data);
      allow create: if legacyStaffCreate(request.resource.data, false);
      allow update: if legacyStaffUpdate(
        resource.data,
        request.resource.data,
        false
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /parcelas/{documentId} {
      allow read: if legacyFinancialRead(
        resource.data,
        resource.data.get('uidGestante', '')
      );
      allow create: if legacyFinancialWrite({}, request.resource.data, true);
      allow update: if legacyFinancialWrite(
        resource.data,
        request.resource.data,
        false
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /parcelasFinanceiras/{documentId} {
      allow read: if legacyFinancialRead(
        resource.data,
        resource.data.get('uidGestante', '')
      );
      allow create: if legacyFinancialWrite({}, request.resource.data, true);
      allow update: if legacyFinancialWrite(
        resource.data,
        request.resource.data,
        false
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /biblioteca/{documentId} {
      allow read: if legacyCatalogRead(resource.data);
      allow create: if legacyCatalogWrite({}, request.resource.data, true);
      allow update: if legacyCatalogWrite(
        resource.data,
        request.resource.data,
        false
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /planos/{documentId} {
      allow read: if legacyCatalogRead(resource.data);
      allow create: if legacyCatalogWrite({}, request.resource.data, true);
      allow update: if legacyCatalogWrite(
        resource.data,
        request.resource.data,
        false
      );
      allow delete: if legacyStaffDelete(resource.data);
    }

    match /clinicasSaaS/{tenantId} {
      allow read: if isSuperAdmin() || isTenantMember(tenantId);
      allow create, update: if isSuperAdmin() &&
        canonicalTenantWrite(request.resource.data, tenantId);
      allow delete: if isSuperAdmin();
    }

    match /assinaturasSaaS/{subscriptionId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          isTenantAdmin(tenantIdFrom(resource.data)));
      allow create: if isSuperAdmin() &&
        canonicalTenantWrite(
          request.resource.data,
          tenantIdFrom(request.resource.data)
        );
      allow update: if isSuperAdmin() &&
        canonicalTenantWrite(request.resource.data, tenantIdFrom(resource.data));
      allow delete: if isSuperAdmin();
    }

    match /usuariosSaaS/{userId} {
      allow read: if isSuperAdmin() ||
        (signedIn() &&
          request.auth.uid == userId &&
          isTenantMember(tenantIdFrom(userData())));
      allow create, update: if isSuperAdmin() &&
        validDirectoryUserPayload(request.resource.data) &&
        request.resource.data.get('uid', '') == userId;
      allow delete: if isSuperAdmin();
    }

    match /logsAdministrativos/{logId} {
      allow read: if isSuperAdmin() ||
        (belongsToTenantDualRead(resource.data, tenantIdFrom(resource.data)) &&
          isTenantAdmin(tenantIdFrom(resource.data)));
      allow create: if canonicalTenantWrite(
          request.resource.data,
          tenantIdFrom(request.resource.data)
        ) &&
        isTenantStaff(tenantIdFrom(request.resource.data)) &&
        request.resource.data.get('usuarioUid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    match /logsSuperAdmin/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Única configuração global legível pelo cliente: chave pública de push.
    match /integracoes/push {
      allow read: if isSuperAdmin() ||
        (activeUser() &&
          tenantAliasesCompatible(userData()) &&
          tenantActive(tenantIdFrom(userData())));
      allow write: if isSuperAdmin();
    }

    // Journal global de criação de clínica, exclusivo do Admin SDK.
    match /operacoesSistema/{operationId} {
      allow read, write: if false;
    }

    // Contadores antifraude e antiabuso, exclusivos das Cloud Functions.
    match /_backendRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Default deny para qualquer caminho não modelado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
